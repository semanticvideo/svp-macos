#!/bin/bash
# Post-install script for SVP System Support
# Runs after the PKG installer copies the app to /Applications

# Touch the app to register UTTypes with Launch Services
if [ -d "/Applications/SVPSystemSupport.app" ]; then
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
        -f "/Applications/SVPSystemSupport.app"
    echo "Registered SVPSystemSupport.app with Launch Services"
fi

# Register Quick Look extension
if [ -d "/Applications/SVPSystemSupport.app/Contents/PlugIns/SVPPreview.appex" ]; then
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
        -f "/Applications/SVPSystemSupport.app/Contents/PlugIns/SVPPreview.appex"
    echo "Registered SVPPreview.appex with Launch Services"
fi

# Register MediaExtension
if [ -d "/Applications/SVPSystemSupport.app/Contents/PlugIns/SVPMediaReader.appex" ]; then
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
        -f "/Applications/SVPSystemSupport.app/Contents/PlugIns/SVPMediaReader.appex"
    echo "Registered SVPMediaReader.appex with Launch Services"
fi

echo "SVP System Support installation complete."
echo ""
echo "You may need to log out and log back in for Quick Look and MediaExtension to activate."
echo "To verify UTType registration: mdls -name kMDItemContentType /path/to/file.svp"

exit 0
