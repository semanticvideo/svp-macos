#!/bin/bash
# Post-install script for SVP System Support
# Runs after the PKG installer copies the app to /Applications

# Touch the app to register UTTypes with Launch Services
if [ -d "/Applications/svp-system-support.app" ]; then
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
        -f "/Applications/svp-system-support.app"
    echo "Registered svp-system-support.app with Launch Services"
fi

# Register Quick Look extension
if [ -d "/Applications/svp-system-support.app/Contents/PlugIns/svp-preview.appex" ]; then
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
        -f "/Applications/svp-system-support.app/Contents/PlugIns/svp-preview.appex"
    echo "Registered svp-preview.appex with Launch Services"
fi

# Register MediaExtension
if [ -d "/Applications/svp-system-support.app/Contents/PlugIns/svp-media-reader.appex" ]; then
    /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
        -f "/Applications/svp-system-support.app/Contents/PlugIns/svp-media-reader.appex"
    echo "Registered svp-media-reader.appex with Launch Services"
fi

echo "SVP System Support installation complete."
echo ""
echo "You may need to log out and log back in for Quick Look and MediaExtension to activate."
echo "To verify UTType registration: mdls -name kMDItemContentType /path/to/file.svp"

exit 0
